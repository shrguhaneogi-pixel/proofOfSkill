# Public — safe in the browser.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=

# Server-only. Never use the NEXT_PUBLIC_ prefix for these.
# All three AI_* must be set together, or none at all: a key with no base URL or
# model cannot be called. With none set, /api/evaluate returns a clearly labelled
# development fallback that scores 0 and can never be issued onchain.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Generate once, keep it out of git:
#   solana-keygen new --no-bip39-passphrase -o .keys/issuer.json
# The value is the file's own contents — a JSON array of 64 secret-key bytes.
ISSUER_PRIVATE_KEY=

# Required: at least 32 bytes of key material, as hex, base64 or plain text.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing ATTESTATION_SECRET invalidates every token already minted (they are
# HMAC-signed with it), which is correct but not graceful: users mid-flow, inside
# the 15 minute window, must evaluate again. Rotating the token *format* is the
# `v` field in the payload instead, so old and new secrets can coexist.
ATTESTATION_SECRET=

# Optional — distributed rate limiting for /api/evaluate.
# Both or neither; with either absent the limiter falls back to the in-process
# window, which resets on restart and is per instance. Get a REST-enabled Redis
# from Upstash and set both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — Postgres-backed challenge catalogue. Unset means the typed catalogue
# in lib/challenges/data.ts is the source of truth. Set it, then seed:
#   node scripts/seed-challenges.ts
# Migration SQL lives in drizzle/migrations; apply with pnpm exec drizzle-kit push.
DATABASE_URL=

# Optional but strongly recommended — repository inspection for the evaluator.
# With no token, /api/evaluate skips fetching GitHub evidence entirely and grades
# only the submitted text, which is the pre-Phase-3 behaviour. A token raises the
# unauthenticated 60 requests/hour/IP limit to 5000 and makes results repeatable.
# Scope: public repos only, `repo` is NOT required.
GITHUB_TOKEN=
