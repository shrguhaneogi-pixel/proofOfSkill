# Public — safe in the browser.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=

# Server-only. Never use the NEXT_PUBLIC_ prefix for these.
# All three AI_* must be set together, or none at all: a key with no base URL or
# model cannot be called. With none set, /api/evaluate returns a clearly labelled
# development fallback that scores 0 and can never be issued onchain.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Generate once, keep it out of git:
#   solana-keygen new --no-bip39-passphrase -o .keys/issuer.json
# The value is the file's own contents — a JSON array of 64 secret-key bytes.
ISSUER_PRIVATE_KEY=

# Required: at least 32 bytes of key material, as hex, base64 or plain text.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTESTATION_SECRET=
